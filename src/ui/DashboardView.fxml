<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="ui.DashboardController"
           prefWidth="600.0"
           prefHeight="400.0">
    <!-- Background Circles (Positioned dynamically in Controller) -->
    <Circle fx:id="planet1" radius="100.0" styleClass="planet" />
    <Circle fx:id="planet2" radius="120.0" styleClass="planet" />
    <Circle fx:id="planet3" radius="90.0" styleClass="planet" />
    <Circle fx:id="planet4" radius="80.0" styleClass="planet" />
    
    <!-- Team Label -->
    <Label fx:id="teamLabel" styleClass="team-label" text="Team 11" 
           StackPane.alignment="CENTER" style="-fx-font-size: 5vw; -fx-text-fill: #61A6D9;" />

    <!-- Welcome Button -->
    <Button fx:id="welcomeButton" text="Welcome" onAction="#handleWelcomeButton" 
            styleClass="button" StackPane.alignment="BOTTOM_CENTER" />

    <!-- Start Tasks Button -->
    <Button fx:id="startTasksButton" text="Start Tasks" onAction="#handleStartTasksButton"
            styleClass="button" StackPane.alignment="BOTTOM_CENTER" layoutY="50" />

    <!-- Welcome Page Content -->
    <AnchorPane fx:id="welcomePage" style="-fx-background-color: transparent;">
        <Label text="Welcome to Team 11's Project!" 
               style="-fx-font-size: 30px; -fx-text-fill: #61A6D9; -fx-alignment: center; -fx-pref-width: 600; -fx-pref-height: 400;" />
    </AnchorPane>

    <!-- Tasks Page Content (Hidden initially) -->
    <AnchorPane fx:id="tasksPage" visible="false" style="-fx-background-color: transparent;">
        <!-- Placeholder for tasks page -->
        <Label text="Tasks Page"
               style="-fx-font-size: 30px; -fx-text-fill: #61A6D9; -fx-alignment: center; -fx-pref-width: 600; -fx-pref-height: 400;" />
    </AnchorPane>
</StackPane>