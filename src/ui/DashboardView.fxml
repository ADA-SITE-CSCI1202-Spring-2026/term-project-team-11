<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ListView?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="ui.DashboardController"
           prefWidth="800.0"
           prefHeight="600.0">
    <!-- Background Circles (Positioned dynamically in Controller) -->
    <Circle fx:id="planet1" radius="100.0" styleClass="planet" />
    <Circle fx:id="planet2" radius="120.0" styleClass="planet" />
    <Circle fx:id="planet3" radius="90.0" styleClass="planet" />
    <Circle fx:id="planet4" radius="80.0" styleClass="planet" />

    <!-- Team Label -->
    <Label fx:id="teamLabel" styleClass="team-label" text="Team 11" 
           StackPane.alignment="CENTER" style="-fx-font-size: 5vw; -fx-text-fill: #61A6D9;" />

    <!-- Welcome Button -->
    <Button fx:id="welcomeButton" text="Welcome" onAction="#handleWelcomeButton" 
            styleClass="button" StackPane.alignment="BOTTOM_CENTER" />

    <!-- Start Tasks Button -->
    <Button fx:id="startTasksButton" text="Start Tasks" onAction="#handleStartTasksButton"
            styleClass="button" StackPane.alignment="BOTTOM_CENTER" layoutY="50" />

    <!-- Welcome Page Content -->
    <AnchorPane fx:id="welcomePage" style="-fx-background-color: transparent;">
        <Label text="Welcome to Team 11's Project!" 
               style="-fx-font-size: 30px; -fx-text-fill: #61A6D9; -fx-alignment: center; -fx-pref-width: 800; -fx-pref-height: 600;" />
    </AnchorPane>

    <!-- Tasks Page Content (Hidden initially) -->
    <AnchorPane fx:id="tasksPage" visible="false" style="-fx-background-color: transparent;">
        <!-- Resource Labels -->
        <Label fx:id="oxygenLabel" layoutX="20" layoutY="20" style="-fx-font-size: 18px; -fx-text-fill: #61A6D9;" />
        <Label fx:id="sparePartsLabel" layoutX="20" layoutY="50" style="-fx-font-size: 18px; -fx-text-fill: #61A6D9;" />
        <Label fx:id="rationsLabel" layoutX="20" layoutY="80" style="-fx-font-size: 18px; -fx-text-fill: #61A6D9;" />
        <Label fx:id="powerLabel" layoutX="20" layoutY="110" style="-fx-font-size: 18px; -fx-text-fill: #61A6D9;" />
        <Label fx:id="creditsLabel" layoutX="20" layoutY="140" style="-fx-font-size: 18px; -fx-text-fill: #61A6D9;" />

        <!-- Task List (VBox) -->
        <VBox fx:id="taskListVBox" layoutX="200" layoutY="20" spacing="10">
            <!-- Tasks will be dynamically added here -->
        </VBox>

        <!-- Task Control Buttons -->
        <Button fx:id="executeNextTaskButton" text="Execute Next Task" onAction="#handleExecuteNextTaskButton" 
                styleClass="button" layoutX="20" layoutY="180" />
        <Button fx:id="synthesizeButton" text="Synthesize Resources" onAction="#handleSynthesizeButton" 
                styleClass="button" layoutX="160" layoutY="180" />
    </AnchorPane>
</StackPane>