<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<StackPane styleClass="main-root" prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.DashboardController">
    <children>
        
        <VBox fx:id="dashboardLayer" visible="false" opacity="0.0" spacing="20">
            <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
            <Label text="ARES BASE: COMMAND CENTER" styleClass="header-glitch" alignment="CENTER" maxWidth="Infinity"/>
            
            <GridPane hgap="30" vgap="20" VBox.vgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                </columnConstraints>
                
                <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS">
                    <Label text="CRITICAL QUEUE" styleClass="zone-title"/>
                    <ListView fx:id="taskListView" VBox.vgrow="ALWAYS" styleClass="terminal-list"/>
                    <Button text="EXECUTE PROTOCOL" onAction="#handleExecute" maxWidth="Infinity" styleClass="action-btn"/>
                </VBox>

                <VBox spacing="20" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="COLONY VITALS" styleClass="zone-title"/>
                    <VBox spacing="15" styleClass="vitals-box">
                        <Label fx:id="lblCredits" text="Credits: --" styleClass="vital-label"/>
                        <Label fx:id="lblOxygen" text="Oxygen: --" styleClass="vital-label"/>
                        <Label fx:id="lblParts" text="Parts: --" styleClass="vital-label"/>
                        <Label fx:id="lblRations" text="Rations: --" styleClass="vital-label"/>
                        
                        <VBox spacing="5">
                            <Label fx:id="lblPower" text="Power: --" styleClass="vital-label"/>
                            <ProgressBar fx:id="pbPower" prefWidth="300.0" progress="0.0" styleClass="power-bar"/>
                        </VBox>
                    </VBox>
                    
                    <Label text="CARGO REPLICATOR" styleClass="zone-title"/>
                    <HBox spacing="10">
                        <ComboBox fx:id="comboRestock" promptText="Select Resource" prefWidth="200.0" styleClass="combo-box"/>
                        <Button text="SYNTHESIZE (50 CR)" onAction="#handleSynthesize" styleClass="action-btn" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                    <Label text="SYSTEM LOG" styleClass="zone-title"/>
                    <TextArea fx:id="logTextArea" editable="false" prefHeight="180.0" styleClass="terminal-log"/>
                </VBox>
            </GridPane>
        </VBox>
        <VBox fx:id="introLayer" alignment="CENTER" spacing="50" styleClass="intro-overlay">
            <Label text="TEAM 11: ARES BASE" styleClass="header-glitch"/>
            
            <Pane fx:id="planetContainer" prefHeight="300" prefWidth="300" maxWidth="300">
                <Circle fx:id="planet1" radius="40" layoutX="150" layoutY="30" styleClass="planet-mars"/>
                <Circle fx:id="planet2" radius="30" layoutX="150" layoutY="270" styleClass="planet-earth"/>
            </Pane>
                
            <Button fx:id="btnStart" text="START SYSTEM" onAction="#handleStart" styleClass="start-btn"/>
        </VBox>

    </children>
</StackPane>